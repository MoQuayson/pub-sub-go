# Broker host/port (RPC transport)
HOST=0.0.0.0
PORT=7000

# Broker port for gRPC transport (separate binary)
GRPC_PORT=50051

# Storage backend: InMemory or Disk
STORAGE=InMemory

# Path for Disk storage log files (used when STORAGE=Disk)
DISK_STORAGE=./bin/logs

# Transport for publisher/subscriber: RPC or GRPC
TRANSPORT=RPC
